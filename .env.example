# Required
GEMINI_API_KEY=your-gemini-api-key-here

# Optional — media generation
KIE_API_KEY=your-kie-api-key-here
FAL_API_KEY=your-fal-api-key-here

# X.com login (for Docker container auto-login)
X_USERNAME=your-email-or-username
X_PASSWORD=your-x-password

# Platform
PLATFORM=x
BROWSER_PROFILE_PATH=./browser-profile

# Scheduling
POSTS_PER_DAY=8
ENGAGEMENT_CYCLE_INTERVAL_HOURS=2
COMMENTS_PER_CYCLE=5
ANALYTICS_SCRAPE_INTERVAL_HOURS=6

# Content reflection
REFLECTION_MIN_POSTS=15
REFLECTION_POST_AGE_HOURS=48

# Campaigns
CAMPAIGN_CHECK_INTERVAL_MINUTES=30
MAX_DMS_PER_HOUR=10

# Adaptive learning
WEIGHT_EVAL_PERIOD_DAYS=7
LEARNING_RATE=0.1
MIN_WEIGHT_FLOOR=0.05

# Rate limits
MAX_POSTS_PER_DAY=15
MAX_COMMENTS_PER_HOUR=15

# Safety
REQUIRE_APPROVAL=false
DRY_RUN=false

# Browser
ENABLE_VNC=false

# Residential Proxy (required for Instagram/TikTok — datacenter IPs get banned)
# Sign up at https://iproyal.com/residential-proxies/ (~$7/GB, traffic never expires)
# PROXY_SERVER=http://geo.iproyal.com:12321
# PROXY_USERNAME=your-iproyal-username
# PROXY_PASSWORD=your-iproyal-password

# TikTok Shop Open API — flash sale (Flash Deal) promotions
# Register a developer app at https://partner.tiktokshop.com to get key + secret,
# then authorize the seller account to get the tokens and shop cipher.
# NOTE: coupons cannot be created via the API — only Flash Deal activities.
# TIKTOK_SHOP_APP_KEY=
# TIKTOK_SHOP_APP_SECRET=
# TIKTOK_SHOP_ACCESS_TOKEN=
# TIKTOK_SHOP_REFRESH_TOKEN=
# TIKTOK_SHOP_CIPHER=
# Leave dry-run ON until the contract is verified and you have explicitly
# approved writing real discounts to the live shop.
TIKTOK_SHOP_DRY_RUN=true

# Database
DB_PATH=data/moderator.db
