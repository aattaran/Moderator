"""UGC creative angle generation — ported from proven video-ad pipeline (130+ validated runs).

5 angle styles × 5 concepts × 4 visual hooks = diverse UGC ad variations.
Each angle produces 3 clips: Hook (8s) + Concept (8s) + CTA (5s) = ~21s total.

Reference: ~/.claude/skills/video-ad-videographer/SKILL.md
Reference JS: strategies/ugc-script-generator.js
"""

import json
import logging
import random
import re

from pydantic import BaseModel

logger = logging.getLogger(__name__)

# ═══════════════════════════════════════════════════════════════
# BASE TONE — applied to every generated angle before per-style
# flavor. This is the overarching voice directive; the style's
# own tone field refines within this frame, it does not override it.
# ═══════════════════════════════════════════════════════════════

